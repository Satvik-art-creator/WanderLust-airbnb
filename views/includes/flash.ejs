<% if(succMsg && succMsg.length) {%>
    <div class="alert alert-success alert-dismissible fade show col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-3" role="alert">
        <strong>Hurray!!</strong> <%=succMsg%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>

<% if(errMsg && errMsg.length) {%>
    <div class="alert alert-danger alert-dismissible fade show col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-3" role="alert">
        <strong>Sorry!!</strong> <%=errMsg%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>